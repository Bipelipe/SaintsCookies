{
  "name": "saints-cookies",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "site:db": "node scripts/local-site.mjs db",
    "site:prepare": "npm run build -- --base=/ && npm run site:db",
    "site:dev": "node scripts/local-site.mjs dev",
    "site:build": "npm run build -- --base=/ && node scripts/configure-dev.mjs",
    "site:deploy": "node scripts/deploy-dev.mjs",
    "site:admin": "node scripts/promote-admin.mjs",
    "test:account": "playwright test --config playwright.account.config.js",
    "site:pages:dev": "node scripts/local-pages.mjs",
    "site:sql": "node scripts/generate-d1-console.mjs",
    "test:account:pages": "playwright test --config playwright.pages-account.config.js",
    "site:roles": "node scripts/prepare-admin-setup.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.1.0",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0"
  }
}
