{
  "name": "saints-cookies",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "credits:db": "node scripts/local-creditos.mjs db",
    "credits:prepare": "npm run build -- --base=/ && npm run credits:db",
    "credits:dev": "node scripts/local-creditos.mjs dev",
    "credits:build": "npm run build -- --base=/ && node scripts/configure-creditos.mjs",
    "credits:deploy": "node scripts/deploy-creditos.mjs",
    "credits:admin": "node scripts/promote-admin.mjs",
    "test:creditos": "playwright test --config playwright.creditos.config.js",
    "credits:pages:dev": "node scripts/local-pages-creditos.mjs",
    "credits:sql": "node scripts/generate-d1-console.mjs",
    "test:creditos:pages": "playwright test --config playwright.pages-creditos.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.1.0",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0"
  }
}
